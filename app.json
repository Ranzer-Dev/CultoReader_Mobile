{
  "expo": {
    "name": "Culto Reader & Compreensão",
    "slug": "leitura-compreensao-culto",
    "version": "1.0.29",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1E1E2E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Reconhecimento de fala offline para transcrição de cultos.",
        "NSMicrophoneUsageDescription": "Microfone para capturar a mensagem do culto em tempo real."
      }
    },
    "android": {
      "package": "com.cultoreader.app",
      "versionCode": 30,
      "adaptiveIcon": {
        "backgroundColor": "#1E1E2E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "cultoreader"
  }
}

